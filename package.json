    "colors": [
      {
        "id": "multiGitExplorer.conflictForeground",
        "description": "Color of repos with conflicts or an unfinished merge, rebase, or cherry-pick.",
        "defaults": {
          "dark": "gitDecoration.conflictingResourceForeground",
          "light": "gitDecoration.conflictingResourceForeground",
          "highContrast": "gitDecoration.conflictingResourceForeground",
          "highContrastLight": "gitDecoration.conflictingResourceForeground"
        }
      },
      {
        "id": "multiGitExplorer.dirtyForeground",
        "description": "Color of repos with uncommitted changes or a detached HEAD.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "multiGitExplorer.aheadForeground",
        "description": "Color of repos with commits that are not pushed yet.",
        "defaults": {
          "dark": "#75BEFF",
          "light": "#1A6FD1",
          "highContrast": "#75BEFF",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "multiGitExplorer.behindForeground",
        "description": "Color of repos that are behind or diverged from their upstream.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#A31BA3",
          "highContrast": "#C586C0",
          "highContrastLight": "#7A1A7A"
        }
      },
      {
        "id": "multiGitExplorer.pendingForeground",
        "description": "Color of repos that are still being checked.",
        "defaults": {
          "dark": "gitDecoration.ignoredResourceForeground",
          "light": "gitDecoration.ignoredResourceForeground",
          "highContrast": "gitDecoration.ignoredResourceForeground",
          "highContrastLight": "gitDecoration.ignoredResourceForeground"
        }
      },
      {
        "id": "multiGitExplorer.errorForeground",
        "description": "Color of repos whose status could not be read.",
        "defaults": {
          "dark": "list.errorForeground",
          "light": "list.errorForeground",
          "highContrast": "list.errorForeground",
          "highContrastLight": "list.errorForeground"
        }
      }
    ],
    "configuration": {
      "title": "Multi-Git Explorer",
      "properties": {
        "multiGitExplorer.scanDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many folder levels below each workspace folder to search for git repositories. Raise it if your repos are deeper than this. Folders past the limit are searched when you expand them."
        },
        "multiGitExplorer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "vendor",
            "dist",
            "build",
            "out",
            "target",
            "bower_components",
            "__pycache__"
          ],
          "description": "Folder names that are never searched for repositories, and are hidden while the file tree is filtered."
        },
        "multiGitExplorer.decorateExplorer": {
          "type": "boolean",
          "default": false,
          "description": "Also show repo colors, badges, and the Git Repo right-click menu in the built-in Explorer. Off by default, so the built-in Explorer stays unchanged."
        },
        "multiGitExplorer.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show the Multi-Git Explorer in the side bar when a window with a folder opens, instead of the built-in Explorer."
        },
        "multiGitExplorer.remoteHosts": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "bitbucket-server",
              "azure",
              "gitea"
            ]
          },
          "markdownDescription": "The kind of website each git host is, for **Copy Remote File URL** and **Open on Remote (Web)**, such as `{ \"git.mycompany.com\": \"github\" }`. Hosts not listed are guessed from their name, and other self-hosted sites are treated as GitLab."
        },
        "multiGitExplorer.maxConcurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of git processes to run at the same time."
        },
        "multiGitExplorer.countUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Count untracked files. Turning this off makes status checks faster in large repos."
        },
        "multiGitExplorer.refreshOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Re-check repos when the VS Code window gets focus, to pick up changes made outside VS Code. In a workspace of more than 100 repos, only the repos whose commits, branches, index or stash changed are re-checked, plus the repo of the active editor; which ones changed is read from .git, without running git."
        },
        "multiGitExplorer.backgroundRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Re-check every repo in the background this often, in minutes. 0 turns it off. This never fetches from remotes. In a workspace of more than 100 repos, it re-checks only the repos whose commits, branches, index or stash changed, and every repo once every 30 minutes."
        }
      }
    },
    "keybindings": [
      {
        "command": "multiGitExplorer.openToSide",
