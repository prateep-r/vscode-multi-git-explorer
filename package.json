      },
      {
        "command": "multiGitExplorer.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == multiGitExplorer.explorer && !inputFocus && config.explorer.enableUndo && multiGitExplorer.canUndo",
