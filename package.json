        }
      },
      {
        "command": "multiGitExplorer.redo",
        "key": "ctrl+y",
        "mac": "shift+cmd+z",
        "linux": "ctrl+shift+z",
        "when": "focusedView == multiGitExplorer.explorer && !inputFocus && config.explorer.enableUndo && multiGitExplorer.canRedo",
        "args": {
          "keyboard": true
        }
      },
      {
        "command": "multiGitExplorer.redo",
        "key": "ctrl+shift+z",
        "when": "focusedView == multiGitExplorer.explorer && !inputFocus && config.explorer.enableUndo && multiGitExplorer.canRedo && isWindows",
        "args": {
          "keyboard": true
        }
      }
    ]
  },
