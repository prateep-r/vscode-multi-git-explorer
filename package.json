{
  "name": "multi-repo-explorer",
  "displayName": "Multi-Repo Explorer",
  "description": "See the branch and status of every git repository in your workspace at a glance, even with hundreds of repos.",
  "version": "1.2.0",
  "publisher": "prateep-r",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prateep-r/vscode-multi-repo-explorer.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "branch",
    "status",
    "polyrepo"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiRepoExplorer",
          "title": "Multi-Repo Explorer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "multiRepoExplorer": [
        {
          "id": "multiRepoExplorer.explorer",
          "name": "Files"
        },
        {
          "id": "multiRepoExplorer.repos",
          "name": "Git Repositories"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multiRepoExplorer.repos",
        "contents": "No git repositories found in this workspace yet.\n[Scan Again](command:multiRepoExplorer.refresh)"
      }
    ],
    "commands": [
      {
        "command": "multiRepoExplorer.refresh",
        "title": "Refresh",
        "category": "Multi-Repo Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "multiRepoExplorer.fetchAll",
        "title": "Fetch All Repos",
        "category": "Multi-Repo Explorer",
        "icon": "$(cloud-download)"
      },
      {
        "command": "multiRepoExplorer.filter",
        "title": "Filter Repos",
        "category": "Multi-Repo Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "multiRepoExplorer.clearFilter",
        "title": "Clear Filter",
        "category": "Multi-Repo Explorer",
        "icon": "$(clear-all)"
      },
      {
        "command": "multiRepoExplorer.filterExplorer",
        "title": "Filter Multi-Repo Explorer...",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.filterChanges",
        "title": "Show Only Changed Files",
        "category": "Multi-Repo Explorer",
        "icon": "$(circle-outline)"
      },
      {
        "command": "multiRepoExplorer.filterChangesOn",
        "title": "Showing Only Changed Files (Click to Turn Off)",
        "category": "Multi-Repo Explorer",
        "icon": "$(circle-filled)"
      },
      {
        "command": "multiRepoExplorer.filterUnpushed",
        "title": "Show Only Repos Not Pushed",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-up)"
      },
      {
        "command": "multiRepoExplorer.filterUnpushedOn",
        "title": "Showing Only Repos Not Pushed (Click to Turn Off)",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "multiRepoExplorer.filterBehind",
        "title": "Show Only Repos Behind Remote",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-down)"
      },
      {
        "command": "multiRepoExplorer.filterBehindOn",
        "title": "Showing Only Repos Behind Remote (Click to Turn Off)",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "multiRepoExplorer.clearExplorerFilter",
        "title": "Show All Files",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openInScm",
        "title": "Open in Source Control",
        "category": "Multi-Repo Explorer",
        "icon": "$(source-control)"
      },
      {
        "command": "multiRepoExplorer.openChanges",
        "title": "View All Changes",
        "category": "Multi-Repo Explorer",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "multiRepoExplorer.openChange",
        "title": "Open Changes",
        "category": "Multi-Repo Explorer",
        "icon": "$(git-compare)"
      },
      {
        "command": "multiRepoExplorer.openChangedFile",
        "title": "Open File",
        "category": "Multi-Repo Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "multiRepoExplorer.switchBranch",
        "title": "Switch Branch...",
        "category": "Multi-Repo Explorer",
        "icon": "$(git-branch)"
      },
      {
        "command": "multiRepoExplorer.fetch",
        "title": "Fetch",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.pull",
        "title": "Pull",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.push",
        "title": "Push",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openTerminal",
        "title": "Open Terminal Here",
        "category": "Multi-Repo Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "multiRepoExplorer.openInNewWindow",
        "title": "Open Repo in New Window",
        "category": "Multi-Repo Explorer",
        "icon": "$(empty-window)"
      },
      {
        "command": "multiRepoExplorer.copyBranch",
        "title": "Copy Branch Name",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.scanFolder",
        "title": "Scan This Folder",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.addTo.claude",
        "title": "Add to Claude Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.addTo.codex",
        "title": "Add to Codex Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.newFile",
        "title": "New File...",
        "category": "Multi-Repo Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "multiRepoExplorer.newFolder",
        "title": "New Folder...",
        "category": "Multi-Repo Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "multiRepoExplorer.copyToAiChat",
        "title": "Copy to AI Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openToSide",
        "title": "Open to the Side",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.revealInFileExplorer",
        "title": "Reveal in File Explorer",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openContainingFolder",
        "title": "Open Containing Folder",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.findInFolder",
        "title": "Find in Folder...",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.selectForCompare",
        "title": "Select for Compare",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.compareWithSelected",
        "title": "Compare with Selected",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.compareSelected",
        "title": "Compare Selected",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openTimeline",
        "title": "Open Timeline",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.cut",
        "title": "Cut",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.copy",
        "title": "Copy",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.paste",
        "title": "Paste",
        "category": "Multi-Repo Explorer",
        "enablement": "multiRepoExplorer.canPaste"
      },
      {
        "command": "multiRepoExplorer.copyPath",
        "title": "Copy Path",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.copyRemoteUrl",
        "title": "Copy Remote File URL",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openOnRemote",
        "title": "Open on Remote (Web)",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.rename",
        "title": "Rename...",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.delete",
        "title": "Delete",
        "category": "Multi-Repo Explorer"
      }
    ],
    "submenus": [
      {
        "id": "multiRepoExplorer.repoMenu",
        "label": "Git Repo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiRepoExplorer.newFile",
          "when": "view == multiRepoExplorer.explorer",
          "group": "navigation@1"
        },
        {
          "command": "multiRepoExplorer.newFolder",
          "when": "view == multiRepoExplorer.explorer",
          "group": "navigation@2"
        },
        {
          "command": "multiRepoExplorer.filterChanges",
          "when": "view == multiRepoExplorer.explorer && !multiRepoExplorer.filter.changes",
          "group": "navigation@3"
        },
        {
          "command": "multiRepoExplorer.filterChangesOn",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.filter.changes",
          "group": "navigation@3"
        },
        {
          "command": "multiRepoExplorer.filterUnpushed",
          "when": "view == multiRepoExplorer.explorer && !multiRepoExplorer.filter.unpushed",
          "group": "navigation@4"
        },
        {
          "command": "multiRepoExplorer.filterUnpushedOn",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.filter.unpushed",
          "group": "navigation@4"
        },
        {
          "command": "multiRepoExplorer.filterBehind",
          "when": "view == multiRepoExplorer.explorer && !multiRepoExplorer.filter.behind",
          "group": "navigation@5"
        },
        {
          "command": "multiRepoExplorer.filterBehindOn",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.filter.behind",
          "group": "navigation@5"
        },
        {
          "command": "multiRepoExplorer.fetchAll",
          "when": "view == multiRepoExplorer.repos",
          "group": "navigation@1"
        },
        {
          "command": "multiRepoExplorer.filter",
          "when": "view == multiRepoExplorer.repos",
          "group": "navigation@2"
        },
        {
          "command": "multiRepoExplorer.clearFilter",
          "when": "view == multiRepoExplorer.repos && multiRepoExplorer.filtered",
          "group": "navigation@3"
        },
        {
          "command": "multiRepoExplorer.refresh",
          "when": "view == multiRepoExplorer.repos || view == multiRepoExplorer.explorer",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "multiRepoExplorer.addTo.claude",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/ && multiRepoExplorer.has.claude",
          "group": "0_chat@1"
        },
        {
          "command": "multiRepoExplorer.addTo.codex",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/ && multiRepoExplorer.has.codex",
          "group": "0_chat@1"
        },
        {
          "command": "multiRepoExplorer.openChangedFile",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bchange\\b(?! deleted)/",
          "group": "inline@1"
        },
        {
          "command": "multiRepoExplorer.openChange",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bchange\\b/",
          "group": "1_open@1"
        },
        {
          "command": "multiRepoExplorer.openChangedFile",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bchange\\b(?! deleted)/",
          "group": "1_open@2"
        },
        {
          "command": "multiRepoExplorer.openInScm",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "inline@1"
        },
        {
          "command": "multiRepoExplorer.openTerminal",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "inline@2"
        },
        {
          "command": "multiRepoExplorer.openInScm",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "1_scm@1"
        },
        {
          "command": "multiRepoExplorer.openChanges",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "1_scm@2"
        },
        {
          "command": "multiRepoExplorer.switchBranch",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "0_branch@1"
        },
        {
          "command": "multiRepoExplorer.fetch",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\bremote\\b/",
          "group": "2_sync@1"
        },
        {
          "command": "multiRepoExplorer.pull",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\bupstream\\b/",
          "group": "2_sync@2"
        },
        {
          "command": "multiRepoExplorer.push",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\bcanPush\\b/",
          "group": "2_sync@3"
        },
        {
          "command": "multiRepoExplorer.openTerminal",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "3_open@1"
        },
        {
          "command": "multiRepoExplorer.openInNewWindow",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "3_open@2"
        },
        {
          "command": "multiRepoExplorer.copyBranch",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "3_open@3"
        },
        {
          "command": "multiRepoExplorer.scanFolder",
          "when": "view =~ /^multiRepoExplorer\\./ && viewItem =~ /\\bunscanned\\b/",
          "group": "1_scan@1"
        },
        {
          "command": "multiRepoExplorer.newFile",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "4_new@1"
        },
        {
          "command": "multiRepoExplorer.newFolder",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "4_new@2"
        },
        {
          "command": "multiRepoExplorer.copyToAiChat",
          "when": "view == multiRepoExplorer.explorer",
          "group": "0_chat@3"
        },
        {
          "command": "multiRepoExplorer.copyToAiChat",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "0_chat@3"
        },
        {
          "command": "multiRepoExplorer.openToSide",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "1_open@3"
        },
        {
          "command": "multiRepoExplorer.revealInFinder",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && isMac",
          "group": "5_reveal@1"
        },
        {
          "command": "multiRepoExplorer.revealInFileExplorer",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && isWindows",
          "group": "5_reveal@1"
        },
        {
          "command": "multiRepoExplorer.openContainingFolder",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && isLinux",
          "group": "5_reveal@1"
        },
        {
          "command": "multiRepoExplorer.openInTerminal",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "5_reveal@2"
        },
        {
          "command": "multiRepoExplorer.revealInExplorer",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "5_reveal@3"
        },
        {
          "command": "multiRepoExplorer.findInFolder",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "6_search@1"
        },
        {
          "command": "multiRepoExplorer.selectForCompare",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "7_compare@1"
        },
        {
          "command": "multiRepoExplorer.compareWithSelected",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/ && multiRepoExplorer.compareSelected",
          "group": "7_compare@2"
        },
        {
          "command": "multiRepoExplorer.compareSelected",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.twoFilesSelected",
          "group": "7_compare@3"
        },
        {
          "command": "multiRepoExplorer.openTimeline",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "7_compare@4"
        },
        {
          "command": "multiRepoExplorer.cut",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && viewItem =~ /^(?!.*\\broot\\b)/",
          "group": "8a_clipboard@1"
        },
        {
          "command": "multiRepoExplorer.copy",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "8a_clipboard@2"
        },
        {
          "command": "multiRepoExplorer.paste",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "8a_clipboard@3"
        },
        {
          "command": "multiRepoExplorer.copyPath",
          "when": "view == multiRepoExplorer.explorer",
          "group": "8b_path@1"
        },
        {
          "command": "multiRepoExplorer.copyRelativePath",
          "when": "view == multiRepoExplorer.explorer",
          "group": "8b_path@2"
        },
        {
          "command": "multiRepoExplorer.copyRemoteUrl",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bhosted\\b/",
          "group": "8c_remote@1"
        },
        {
          "command": "multiRepoExplorer.openOnRemote",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bhosted\\b/",
          "group": "8c_remote@2"
        },
        {
          "command": "multiRepoExplorer.rename",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && viewItem =~ /^(?!.*\\broot\\b)/",
          "group": "9_modify@1"
        },
        {
          "command": "multiRepoExplorer.delete",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && viewItem =~ /^(?!.*\\broot\\b)/",
          "group": "9_modify@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "multiRepoExplorer.repoMenu",
          "when": "explorerResourceIsFolder && config.multiRepoExplorer.decorateExplorer && resourcePath in multiRepoExplorer.repoPaths",
          "group": "7_multiRepoExplorer@1"
        }
      ],
      "multiRepoExplorer.repoMenu": [
        {
          "command": "multiRepoExplorer.openInScm",
          "group": "1_scm@1"
        },
        {
          "command": "multiRepoExplorer.openChanges",
          "group": "1_scm@2"
        },
        {
          "command": "multiRepoExplorer.switchBranch",
          "group": "0_branch@1"
        },
        {
          "command": "multiRepoExplorer.fetch",
          "group": "2_sync@1"
        },
        {
          "command": "multiRepoExplorer.pull",
          "group": "2_sync@2"
        },
        {
          "command": "multiRepoExplorer.push",
          "group": "2_sync@3"
        },
        {
          "command": "multiRepoExplorer.openTerminal",
          "group": "3_open@1"
        },
        {
          "command": "multiRepoExplorer.openInNewWindow",
          "group": "3_open@2"
        },
        {
          "command": "multiRepoExplorer.copyBranch",
          "group": "3_open@3"
        }
      ],
      "commandPalette": [
        {
          "command": "multiRepoExplorer.openChanges",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.fetch",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.pull",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.push",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openInNewWindow",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyBranch",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.scanFolder",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.clearFilter",
          "when": "multiRepoExplorer.filtered"
        },
        {
          "command": "multiRepoExplorer.clearExplorerFilter",
          "when": "multiRepoExplorer.explorerFiltered"
        },
        {
          "command": "multiRepoExplorer.filterChangesOn",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.filterUnpushedOn",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.filterBehindOn",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openChange",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openChangedFile",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.addTo.claude",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.addTo.codex",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyToAiChat",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openToSide",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.revealInFinder",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.revealInFileExplorer",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openContainingFolder",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openInTerminal",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.revealInExplorer",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.findInFolder",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.selectForCompare",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.compareWithSelected",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.compareSelected",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openTimeline",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.cut",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copy",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.paste",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyPath",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyRelativePath",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyRemoteUrl",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openOnRemote",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.rename",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.delete",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "multiRepoExplorer.conflictForeground",
        "description": "Color of repos with conflicts or an unfinished merge, rebase, or cherry-pick.",
        "defaults": {
          "dark": "gitDecoration.conflictingResourceForeground",
          "light": "gitDecoration.conflictingResourceForeground",
          "highContrast": "gitDecoration.conflictingResourceForeground",
          "highContrastLight": "gitDecoration.conflictingResourceForeground"
        }
      },
      {
        "id": "multiRepoExplorer.dirtyForeground",
        "description": "Color of repos with uncommitted changes or a detached HEAD.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "multiRepoExplorer.aheadForeground",
        "description": "Color of repos with commits that are not pushed yet.",
        "defaults": {
          "dark": "#75BEFF",
          "light": "#1A6FD1",
          "highContrast": "#75BEFF",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "multiRepoExplorer.behindForeground",
        "description": "Color of repos that are behind or diverged from their upstream.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#A31BA3",
          "highContrast": "#C586C0",
          "highContrastLight": "#7A1A7A"
        }
      },
      {
        "id": "multiRepoExplorer.pendingForeground",
        "description": "Color of repos that are still being checked.",
        "defaults": {
          "dark": "gitDecoration.ignoredResourceForeground",
          "light": "gitDecoration.ignoredResourceForeground",
          "highContrast": "gitDecoration.ignoredResourceForeground",
          "highContrastLight": "gitDecoration.ignoredResourceForeground"
        }
      },
      {
        "id": "multiRepoExplorer.errorForeground",
        "description": "Color of repos whose status could not be read.",
        "defaults": {
          "dark": "list.errorForeground",
          "light": "list.errorForeground",
          "highContrast": "list.errorForeground",
          "highContrastLight": "list.errorForeground"
        }
      }
    ],
    "configuration": {
      "title": "Multi-Repo Explorer",
      "properties": {
        "multiRepoExplorer.scanDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many folder levels below each workspace folder to search for git repositories. Raise it if your repos are deeper than this. Folders past the limit are searched when you expand them."
        },
        "multiRepoExplorer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "vendor",
            "dist",
            "build",
            "out",
            "target",
            "bower_components",
            "__pycache__"
          ],
          "description": "Folder names that are never searched for repositories, and are hidden while the file tree is filtered."
        },
        "multiRepoExplorer.decorateExplorer": {
          "type": "boolean",
          "default": false,
          "description": "Also show repo colors, badges, and the Git Repo right-click menu in the built-in Explorer. Off by default, so the built-in Explorer stays unchanged."
        },
        "multiRepoExplorer.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show the Multi-Repo Explorer in the side bar when a window with a folder opens, instead of the built-in Explorer."
        },
        "multiRepoExplorer.remoteHosts": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "bitbucket-server",
              "azure",
              "gitea"
            ]
          },
          "markdownDescription": "The kind of website each git host is, for **Copy Remote File URL** and **Open on Remote (Web)**, such as `{ \"git.mycompany.com\": \"github\" }`. Hosts not listed are guessed from their name, and other self-hosted sites are treated as GitLab."
        },
        "multiRepoExplorer.maxConcurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of git processes to run at the same time."
        },
        "multiRepoExplorer.countUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Count untracked files. Turning this off makes status checks faster in large repos."
        },
        "multiRepoExplorer.refreshOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Re-check repos when the VS Code window gets focus, to pick up changes made outside VS Code."
        },
        "multiRepoExplorer.backgroundRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Re-check every repo in the background this often. 0 turns it off. This never fetches from remotes."
        }
      }
    },
    "keybindings": [
      {
        "command": "multiRepoExplorer.openToSide",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.revealInFinder",
        "key": "alt+cmd+r",
        "mac": "alt+cmd+r",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus && isMac"
      },
      {
        "command": "multiRepoExplorer.revealInFileExplorer",
        "key": "shift+alt+r",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus && isWindows"
      },
      {
        "command": "multiRepoExplorer.openContainingFolder",
        "key": "ctrl+alt+r",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus && isLinux"
      },
      {
        "command": "multiRepoExplorer.findInFolder",
        "key": "shift+alt+f",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus && multiRepoExplorer.canPaste"
      },
      {
        "command": "multiRepoExplorer.copyPath",
        "key": "shift+alt+c",
        "mac": "alt+cmd+c",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.copyRelativePath",
        "key": "ctrl+shift+alt+c",
        "mac": "alt+shift+cmd+c",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.rename",
        "key": "f2",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      },
      {
        "command": "multiRepoExplorer.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == multiRepoExplorer.explorer && !inputFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "test:integration": "tsc -p . && node out/integration/run.js",
    "test:e2e": "tsc -p . && node out/e2e/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.0"
  }
}
