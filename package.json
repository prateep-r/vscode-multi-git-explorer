{
  "name": "multi-repo-explorer",
  "displayName": "Multi-Repo Explorer",
  "description": "See the branch and status of every git repository in your workspace at a glance, even with hundreds of repos.",
  "version": "1.0.0",
  "publisher": "prateep-r",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prateep-r/vscode-multi-repo-explorer.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "branch",
    "status",
    "polyrepo"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiRepoExplorer",
          "title": "Repo Explorer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "multiRepoExplorer": [
        {
          "id": "multiRepoExplorer.explorer",
          "name": "Files"
        },
        {
          "id": "multiRepoExplorer.repos",
          "name": "Git Repos"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multiRepoExplorer.repos",
        "contents": "No git repositories found in this workspace yet.\n[Scan Again](command:multiRepoExplorer.refresh)"
      }
    ],
    "commands": [
      {
        "command": "multiRepoExplorer.refresh",
        "title": "Refresh",
        "category": "Multi-Repo Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "multiRepoExplorer.fetchAll",
        "title": "Fetch All Repos",
        "category": "Multi-Repo Explorer",
        "icon": "$(cloud-download)"
      },
      {
        "command": "multiRepoExplorer.filter",
        "title": "Filter Repos",
        "category": "Multi-Repo Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "multiRepoExplorer.clearFilter",
        "title": "Clear Filter",
        "category": "Multi-Repo Explorer",
        "icon": "$(clear-all)"
      },
      {
        "command": "multiRepoExplorer.filterExplorer",
        "title": "Filter Repo Explorer...",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.filterChanges",
        "title": "Show Only Changed Files",
        "category": "Multi-Repo Explorer",
        "icon": "$(circle-outline)"
      },
      {
        "command": "multiRepoExplorer.filterChangesOn",
        "title": "Showing Only Changed Files (Click to Turn Off)",
        "category": "Multi-Repo Explorer",
        "icon": "$(circle-filled)"
      },
      {
        "command": "multiRepoExplorer.filterUnpushed",
        "title": "Show Only Repos Not Pushed",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-up)"
      },
      {
        "command": "multiRepoExplorer.filterUnpushedOn",
        "title": "Showing Only Repos Not Pushed (Click to Turn Off)",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "multiRepoExplorer.filterBehind",
        "title": "Show Only Repos Behind Remote",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-down)"
      },
      {
        "command": "multiRepoExplorer.filterBehindOn",
        "title": "Showing Only Repos Behind Remote (Click to Turn Off)",
        "category": "Multi-Repo Explorer",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "multiRepoExplorer.clearExplorerFilter",
        "title": "Show All Files",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openInScm",
        "title": "Open in Source Control",
        "category": "Multi-Repo Explorer",
        "icon": "$(source-control)"
      },
      {
        "command": "multiRepoExplorer.openChanges",
        "title": "View All Changes",
        "category": "Multi-Repo Explorer",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "multiRepoExplorer.openChange",
        "title": "Open Changes",
        "category": "Multi-Repo Explorer",
        "icon": "$(git-compare)"
      },
      {
        "command": "multiRepoExplorer.openChangedFile",
        "title": "Open File",
        "category": "Multi-Repo Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "multiRepoExplorer.switchBranch",
        "title": "Switch Branch...",
        "category": "Multi-Repo Explorer",
        "icon": "$(git-branch)"
      },
      {
        "command": "multiRepoExplorer.fetch",
        "title": "Fetch",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.pull",
        "title": "Pull",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.push",
        "title": "Push",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.openTerminal",
        "title": "Open Terminal Here",
        "category": "Multi-Repo Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "multiRepoExplorer.openInNewWindow",
        "title": "Open Repo in New Window",
        "category": "Multi-Repo Explorer",
        "icon": "$(empty-window)"
      },
      {
        "command": "multiRepoExplorer.copyBranch",
        "title": "Copy Branch Name",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.scanFolder",
        "title": "Scan This Folder",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.addTo.claude",
        "title": "Add to Claude Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.copyTo.claude",
        "title": "Copy to Claude Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.addTo.codex",
        "title": "Add to Codex Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.copyTo.codex",
        "title": "Copy to Codex Chat",
        "category": "Multi-Repo Explorer"
      },
      {
        "command": "multiRepoExplorer.newFile",
        "title": "New File...",
        "category": "Multi-Repo Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "multiRepoExplorer.newFolder",
        "title": "New Folder...",
        "category": "Multi-Repo Explorer",
        "icon": "$(new-folder)"
      }
    ],
    "submenus": [
      {
        "id": "multiRepoExplorer.repoMenu",
        "label": "Git Repo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiRepoExplorer.newFile",
          "when": "view == multiRepoExplorer.explorer",
          "group": "navigation@1"
        },
        {
          "command": "multiRepoExplorer.newFolder",
          "when": "view == multiRepoExplorer.explorer",
          "group": "navigation@2"
        },
        {
          "command": "multiRepoExplorer.filterChanges",
          "when": "view == multiRepoExplorer.explorer && !multiRepoExplorer.filter.changes",
          "group": "navigation@3"
        },
        {
          "command": "multiRepoExplorer.filterChangesOn",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.filter.changes",
          "group": "navigation@3"
        },
        {
          "command": "multiRepoExplorer.filterUnpushed",
          "when": "view == multiRepoExplorer.explorer && !multiRepoExplorer.filter.unpushed",
          "group": "navigation@4"
        },
        {
          "command": "multiRepoExplorer.filterUnpushedOn",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.filter.unpushed",
          "group": "navigation@4"
        },
        {
          "command": "multiRepoExplorer.filterBehind",
          "when": "view == multiRepoExplorer.explorer && !multiRepoExplorer.filter.behind",
          "group": "navigation@5"
        },
        {
          "command": "multiRepoExplorer.filterBehindOn",
          "when": "view == multiRepoExplorer.explorer && multiRepoExplorer.filter.behind",
          "group": "navigation@5"
        },
        {
          "command": "multiRepoExplorer.fetchAll",
          "when": "view == multiRepoExplorer.repos",
          "group": "navigation@1"
        },
        {
          "command": "multiRepoExplorer.filter",
          "when": "view == multiRepoExplorer.repos",
          "group": "navigation@2"
        },
        {
          "command": "multiRepoExplorer.clearFilter",
          "when": "view == multiRepoExplorer.repos && multiRepoExplorer.filtered",
          "group": "navigation@3"
        },
        {
          "command": "multiRepoExplorer.refresh",
          "when": "view == multiRepoExplorer.repos || view == multiRepoExplorer.explorer",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "multiRepoExplorer.addTo.claude",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file/ && multiRepoExplorer.has.claude",
          "group": "0_chat@1"
        },
        {
          "command": "multiRepoExplorer.copyTo.claude",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/ && multiRepoExplorer.has.claude",
          "group": "0_chat@2"
        },
        {
          "command": "multiRepoExplorer.copyTo.claude",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/ && multiRepoExplorer.has.claude",
          "group": "0_chat@2"
        },
        {
          "command": "multiRepoExplorer.addTo.codex",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^file/ && multiRepoExplorer.has.codex",
          "group": "0_chat@1"
        },
        {
          "command": "multiRepoExplorer.copyTo.codex",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/ && multiRepoExplorer.has.codex",
          "group": "0_chat@2"
        },
        {
          "command": "multiRepoExplorer.copyTo.codex",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/ && multiRepoExplorer.has.codex",
          "group": "0_chat@2"
        },
        {
          "command": "multiRepoExplorer.openChangedFile",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bchange\\b(?! deleted)/",
          "group": "inline@1"
        },
        {
          "command": "multiRepoExplorer.openChange",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bchange\\b/",
          "group": "1_open@1"
        },
        {
          "command": "multiRepoExplorer.openChangedFile",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /\\bchange\\b(?! deleted)/",
          "group": "1_open@2"
        },
        {
          "command": "multiRepoExplorer.openInScm",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "inline@1"
        },
        {
          "command": "multiRepoExplorer.openTerminal",
          "when": "view == multiRepoExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "inline@2"
        },
        {
          "command": "multiRepoExplorer.openInScm",
          "when": "viewItem =~ /\\brepo\\b/",
          "group": "1_scm@1"
        },
        {
          "command": "multiRepoExplorer.openChanges",
          "when": "viewItem =~ /\\brepo\\b/",
          "group": "1_scm@2"
        },
        {
          "command": "multiRepoExplorer.switchBranch",
          "when": "viewItem =~ /\\brepo\\b/",
          "group": "0_branch@1"
        },
        {
          "command": "multiRepoExplorer.fetch",
          "when": "viewItem =~ /\\bremote\\b/",
          "group": "2_sync@1"
        },
        {
          "command": "multiRepoExplorer.pull",
          "when": "viewItem =~ /\\bupstream\\b/",
          "group": "2_sync@2"
        },
        {
          "command": "multiRepoExplorer.push",
          "when": "viewItem =~ /\\bcanPush\\b/",
          "group": "2_sync@3"
        },
        {
          "command": "multiRepoExplorer.openTerminal",
          "when": "viewItem =~ /\\brepo\\b/",
          "group": "3_open@1"
        },
        {
          "command": "multiRepoExplorer.openInNewWindow",
          "when": "viewItem =~ /\\brepo\\b/",
          "group": "3_open@2"
        },
        {
          "command": "multiRepoExplorer.copyBranch",
          "when": "viewItem =~ /\\brepo\\b/",
          "group": "3_open@3"
        },
        {
          "command": "multiRepoExplorer.scanFolder",
          "when": "viewItem =~ /\\bunscanned\\b/",
          "group": "1_scan@1"
        },
        {
          "command": "multiRepoExplorer.newFile",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "4_new@1"
        },
        {
          "command": "multiRepoExplorer.newFolder",
          "when": "view == multiRepoExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "4_new@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "multiRepoExplorer.repoMenu",
          "when": "explorerResourceIsFolder && config.multiRepoExplorer.decorateExplorer && resourcePath in multiRepoExplorer.repoPaths",
          "group": "7_multiRepoExplorer@1"
        }
      ],
      "multiRepoExplorer.repoMenu": [
        {
          "command": "multiRepoExplorer.openInScm",
          "group": "1_scm@1"
        },
        {
          "command": "multiRepoExplorer.openChanges",
          "group": "1_scm@2"
        },
        {
          "command": "multiRepoExplorer.switchBranch",
          "group": "0_branch@1"
        },
        {
          "command": "multiRepoExplorer.fetch",
          "group": "2_sync@1"
        },
        {
          "command": "multiRepoExplorer.pull",
          "group": "2_sync@2"
        },
        {
          "command": "multiRepoExplorer.push",
          "group": "2_sync@3"
        },
        {
          "command": "multiRepoExplorer.openTerminal",
          "group": "3_open@1"
        },
        {
          "command": "multiRepoExplorer.openInNewWindow",
          "group": "3_open@2"
        },
        {
          "command": "multiRepoExplorer.copyBranch",
          "group": "3_open@3"
        }
      ],
      "commandPalette": [
        {
          "command": "multiRepoExplorer.openChanges",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.fetch",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.pull",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.push",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openInNewWindow",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyBranch",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.scanFolder",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.clearFilter",
          "when": "multiRepoExplorer.filtered"
        },
        {
          "command": "multiRepoExplorer.clearExplorerFilter",
          "when": "multiRepoExplorer.explorerFiltered"
        },
        {
          "command": "multiRepoExplorer.filterChangesOn",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.filterUnpushedOn",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.filterBehindOn",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openChange",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.openChangedFile",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.addTo.claude",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyTo.claude",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.addTo.codex",
          "when": "false"
        },
        {
          "command": "multiRepoExplorer.copyTo.codex",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "multiRepoExplorer.conflictForeground",
        "description": "Color of repos with conflicts or an unfinished merge, rebase, or cherry-pick.",
        "defaults": {
          "dark": "gitDecoration.conflictingResourceForeground",
          "light": "gitDecoration.conflictingResourceForeground",
          "highContrast": "gitDecoration.conflictingResourceForeground",
          "highContrastLight": "gitDecoration.conflictingResourceForeground"
        }
      },
      {
        "id": "multiRepoExplorer.dirtyForeground",
        "description": "Color of repos with uncommitted changes or a detached HEAD.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "multiRepoExplorer.aheadForeground",
        "description": "Color of repos with commits that are not pushed yet.",
        "defaults": {
          "dark": "#75BEFF",
          "light": "#1A6FD1",
          "highContrast": "#75BEFF",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "multiRepoExplorer.behindForeground",
        "description": "Color of repos that are behind or diverged from their upstream.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#A31BA3",
          "highContrast": "#C586C0",
          "highContrastLight": "#7A1A7A"
        }
      },
      {
        "id": "multiRepoExplorer.pendingForeground",
        "description": "Color of repos that are still being checked.",
        "defaults": {
          "dark": "gitDecoration.ignoredResourceForeground",
          "light": "gitDecoration.ignoredResourceForeground",
          "highContrast": "gitDecoration.ignoredResourceForeground",
          "highContrastLight": "gitDecoration.ignoredResourceForeground"
        }
      },
      {
        "id": "multiRepoExplorer.errorForeground",
        "description": "Color of repos whose status could not be read.",
        "defaults": {
          "dark": "list.errorForeground",
          "light": "list.errorForeground",
          "highContrast": "list.errorForeground",
          "highContrastLight": "list.errorForeground"
        }
      }
    ],
    "configuration": {
      "title": "Multi-Repo Explorer",
      "properties": {
        "multiRepoExplorer.scanDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many folder levels below each workspace folder to search for git repositories. Raise it if your repos are deeper than this. Folders past the limit are searched when you expand them."
        },
        "multiRepoExplorer.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "vendor",
            "dist",
            "build",
            "out",
            "target",
            "bower_components",
            "__pycache__"
          ],
          "description": "Folder names that are never searched for repositories, and are hidden while the Repo Explorer is filtered."
        },
        "multiRepoExplorer.decorateExplorer": {
          "type": "boolean",
          "default": false,
          "description": "Also show repo colors, badges, and the Git Repo right-click menu in the built-in Explorer. Off by default, so the built-in Explorer stays unchanged."
        },
        "multiRepoExplorer.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show the Repo Explorer in the side bar when a window with a folder opens, instead of the built-in Explorer."
        },
        "multiRepoExplorer.maxConcurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of git processes to run at the same time."
        },
        "multiRepoExplorer.countUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Count untracked files. Turning this off makes status checks faster in large repos."
        },
        "multiRepoExplorer.refreshOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Re-check repos when the VS Code window gets focus, to pick up changes made outside VS Code."
        },
        "multiRepoExplorer.backgroundRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Re-check every repo in the background this often. 0 turns it off. This never fetches from remotes."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "test:integration": "tsc -p . && node out/integration/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.6.0"
  }
}
