{
  "name": "multi-git-explorer",
  "displayName": "Multi-Git Explorer",
  "description": "See the branch and status of every git repository in your workspace at a glance, even with hundreds of repos.",
  "version": "1.3.3",
  "publisher": "prateep-r",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1A4FA8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prateep-r/vscode-multi-git-explorer.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "multi-git",
    "branch",
    "status",
    "polyrepo"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs git in every repo of the workspace, and a repo's git config can run programs."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiGitExplorer",
          "title": "Multi-Git Explorer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "multiGitExplorer": [
        {
          "id": "multiGitExplorer.explorer",
          "name": "Files"
        },
        {
          "id": "multiGitExplorer.repos",
          "name": "Git Repositories"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multiGitExplorer.repos",
        "contents": "No git repositories found in this workspace yet.\n[Scan Again](command:multiGitExplorer.refresh)"
      }
    ],
    "commands": [
      {
        "command": "multiGitExplorer.refresh",
        "title": "Refresh",
        "category": "Multi-Git Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "multiGitExplorer.fetchAll",
        "title": "Fetch All Repos",
        "category": "Multi-Git Explorer",
        "icon": "$(cloud-download)"
      },
      {
        "command": "multiGitExplorer.filter",
        "title": "Filter Repos",
        "category": "Multi-Git Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "multiGitExplorer.clearFilter",
        "title": "Clear Filter",
        "category": "Multi-Git Explorer",
        "icon": "$(clear-all)"
      },
      {
        "command": "multiGitExplorer.filterExplorer",
        "title": "Filter Multi-Git Explorer...",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.filterChanges",
        "title": "Show Only Changed Files",
        "category": "Multi-Git Explorer",
        "icon": "$(circle-outline)"
      },
      {
        "command": "multiGitExplorer.filterChangesOn",
        "title": "Showing Only Changed Files (Click to Turn Off)",
        "category": "Multi-Git Explorer",
        "icon": "$(circle-filled)"
      },
      {
        "command": "multiGitExplorer.filterUnpushed",
        "title": "Show Only Repos Not Pushed",
        "category": "Multi-Git Explorer",
        "icon": "$(arrow-up)"
      },
      {
        "command": "multiGitExplorer.filterUnpushedOn",
        "title": "Showing Only Repos Not Pushed (Click to Turn Off)",
        "category": "Multi-Git Explorer",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "multiGitExplorer.filterBehind",
        "title": "Show Only Repos Behind Remote",
        "category": "Multi-Git Explorer",
        "icon": "$(arrow-down)"
      },
      {
        "command": "multiGitExplorer.filterBehindOn",
        "title": "Showing Only Repos Behind Remote (Click to Turn Off)",
        "category": "Multi-Git Explorer",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "multiGitExplorer.clearExplorerFilter",
        "title": "Show All Files",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openInScm",
        "title": "Open in Source Control",
        "category": "Multi-Git Explorer",
        "icon": "$(source-control)"
      },
      {
        "command": "multiGitExplorer.openChanges",
        "title": "View All Changes",
        "category": "Multi-Git Explorer",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "multiGitExplorer.openChange",
        "title": "Open Changes",
        "category": "Multi-Git Explorer",
        "icon": "$(git-compare)"
      },
      {
        "command": "multiGitExplorer.openChangedFile",
        "title": "Open File",
        "category": "Multi-Git Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "multiGitExplorer.switchBranch",
        "title": "Switch Branch...",
        "category": "Multi-Git Explorer",
        "icon": "$(git-branch)"
      },
      {
        "command": "multiGitExplorer.fetch",
        "title": "Fetch",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.pull",
        "title": "Pull",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.push",
        "title": "Push",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openTerminal",
        "title": "Open Terminal Here",
        "category": "Multi-Git Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "multiGitExplorer.openInNewWindow",
        "title": "Open Repo in New Window",
        "category": "Multi-Git Explorer",
        "icon": "$(empty-window)"
      },
      {
        "command": "multiGitExplorer.copyBranch",
        "title": "Copy Branch Name",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.scanFolder",
        "title": "Scan This Folder",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.addTo.claude",
        "title": "Add to Claude Chat",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.addTo.codex",
        "title": "Add to Codex Chat",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.newFile",
        "title": "New File...",
        "category": "Multi-Git Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "multiGitExplorer.newFolder",
        "title": "New Folder...",
        "category": "Multi-Git Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "multiGitExplorer.copyToAiChat",
        "title": "Copy to AI Chat",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openToSide",
        "title": "Open to the Side",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.revealInFileExplorer",
        "title": "Reveal in File Explorer",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openContainingFolder",
        "title": "Open Containing Folder",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.revealInFiles",
        "title": "Reveal in Multi-Git Explorer",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.findInFolder",
        "title": "Find in Folder...",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.selectForCompare",
        "title": "Select for Compare",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.compareWithSelected",
        "title": "Compare with Selected",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.compareSelected",
        "title": "Compare Selected",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openTimeline",
        "title": "Open Timeline",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.cut",
        "title": "Cut",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.copy",
        "title": "Copy",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.paste",
        "title": "Paste",
        "category": "Multi-Git Explorer",
        "enablement": "multiGitExplorer.canPaste"
      },
      {
        "command": "multiGitExplorer.copyPath",
        "title": "Copy Path",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.copyRemoteUrl",
        "title": "Copy Remote File URL",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openOnRemote",
        "title": "Open on Remote (Web)",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.rename",
        "title": "Rename...",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.delete",
        "title": "Delete",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openWith",
        "title": "Open With...",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openPreserveFocus",
        "title": "Open Keeping Focus",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.openAndPassFocus",
        "title": "Open and Focus the Editor",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.deletePermanently",
        "title": "Delete Permanently",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.addRootFolder",
        "title": "Add Folder to Workspace...",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.removeRootFolder",
        "title": "Remove Folder from Workspace",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.cancelCut",
        "title": "Cancel Cut",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.undo",
        "title": "Undo File Operation",
        "category": "Multi-Git Explorer"
      },
      {
        "command": "multiGitExplorer.redo",
        "title": "Redo File Operation",
        "category": "Multi-Git Explorer"
      }
    ],
    "submenus": [
      {
        "id": "multiGitExplorer.repoMenu",
        "label": "Git Repo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiGitExplorer.newFile",
          "when": "view == multiGitExplorer.explorer",
          "group": "navigation@1"
        },
        {
          "command": "multiGitExplorer.newFolder",
          "when": "view == multiGitExplorer.explorer",
          "group": "navigation@2"
        },
        {
          "command": "multiGitExplorer.filterChanges",
          "when": "view == multiGitExplorer.explorer && !multiGitExplorer.filter.changes",
          "group": "navigation@3"
        },
        {
          "command": "multiGitExplorer.filterChangesOn",
          "when": "view == multiGitExplorer.explorer && multiGitExplorer.filter.changes",
          "group": "navigation@3"
        },
        {
          "command": "multiGitExplorer.filterUnpushed",
          "when": "view == multiGitExplorer.explorer && !multiGitExplorer.filter.unpushed",
          "group": "navigation@4"
        },
        {
          "command": "multiGitExplorer.filterUnpushedOn",
          "when": "view == multiGitExplorer.explorer && multiGitExplorer.filter.unpushed",
          "group": "navigation@4"
        },
        {
          "command": "multiGitExplorer.filterBehind",
          "when": "view == multiGitExplorer.explorer && !multiGitExplorer.filter.behind",
          "group": "navigation@5"
        },
        {
          "command": "multiGitExplorer.filterBehindOn",
          "when": "view == multiGitExplorer.explorer && multiGitExplorer.filter.behind",
          "group": "navigation@5"
        },
        {
          "command": "multiGitExplorer.fetchAll",
          "when": "view == multiGitExplorer.repos",
          "group": "navigation@1"
        },
        {
          "command": "multiGitExplorer.filter",
          "when": "view == multiGitExplorer.repos",
          "group": "navigation@2"
        },
        {
          "command": "multiGitExplorer.clearFilter",
          "when": "view == multiGitExplorer.repos && multiGitExplorer.filtered",
          "group": "navigation@3"
        },
        {
          "command": "multiGitExplorer.refresh",
          "when": "view == multiGitExplorer.repos || view == multiGitExplorer.explorer",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "multiGitExplorer.addTo.claude",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/ && multiGitExplorer.has.claude",
          "group": "0_chat@1"
        },
        {
          "command": "multiGitExplorer.addTo.codex",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/ && multiGitExplorer.has.codex",
          "group": "0_chat@1"
        },
        {
          "command": "multiGitExplorer.openChangedFile",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\bchange\\b(?! deleted)/",
          "group": "inline@1"
        },
        {
          "command": "multiGitExplorer.openChange",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\bchange\\b/",
          "group": "1_open@1"
        },
        {
          "command": "multiGitExplorer.openChangedFile",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\bchange\\b(?! deleted)/",
          "group": "1_open@2"
        },
        {
          "command": "multiGitExplorer.openInScm",
          "when": "view == multiGitExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "inline@1"
        },
        {
          "command": "multiGitExplorer.openTerminal",
          "when": "view == multiGitExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "inline@2"
        },
        {
          "command": "multiGitExplorer.openInScm",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "1_scm@1"
        },
        {
          "command": "multiGitExplorer.openChanges",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "1_scm@2"
        },
        {
          "command": "multiGitExplorer.switchBranch",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "0_branch@1"
        },
        {
          "command": "multiGitExplorer.fetch",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\bremote\\b/",
          "group": "2_sync@1"
        },
        {
          "command": "multiGitExplorer.pull",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\bupstream\\b/",
          "group": "2_sync@2"
        },
        {
          "command": "multiGitExplorer.push",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\bcanPush\\b/",
          "group": "2_sync@3"
        },
        {
          "command": "multiGitExplorer.openTerminal",
          "when": "view == multiGitExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "3_open@1"
        },
        {
          "command": "multiGitExplorer.openInNewWindow",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "3_open@2"
        },
        {
          "command": "multiGitExplorer.copyBranch",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\brepo\\b/",
          "group": "3_open@3"
        },
        {
          "command": "multiGitExplorer.scanFolder",
          "when": "view =~ /^multiGitExplorer\\./ && viewItem =~ /\\bunscanned\\b/",
          "group": "1_scan@1"
        },
        {
          "command": "multiGitExplorer.newFile",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "4_new@1"
        },
        {
          "command": "multiGitExplorer.newFolder",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "4_new@2"
        },
        {
          "command": "multiGitExplorer.addRootFolder",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\broot\\b/ && enterMultiRootWorkspaceSupport",
          "group": "4_workspace@1"
        },
        {
          "command": "multiGitExplorer.removeRootFolder",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\broot\\b/ && enterMultiRootWorkspaceSupport",
          "group": "4_workspace@2"
        },
        {
          "command": "multiGitExplorer.copyToAiChat",
          "when": "view == multiGitExplorer.explorer",
          "group": "0_chat@3"
        },
        {
          "command": "multiGitExplorer.copyToAiChat",
          "when": "view == multiGitExplorer.repos && viewItem =~ /\\brepo\\b/",
          "group": "0_chat@3"
        },
        {
          "command": "multiGitExplorer.openToSide",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "1_open@3"
        },
        {
          "command": "multiGitExplorer.openWith",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "1_open@4"
        },
        {
          "command": "multiGitExplorer.revealInFinder",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && isMac",
          "group": "5_reveal@1"
        },
        {
          "command": "multiGitExplorer.revealInFileExplorer",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && isWindows",
          "group": "5_reveal@1"
        },
        {
          "command": "multiGitExplorer.openContainingFolder",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && isLinux",
          "group": "5_reveal@1"
        },
        {
          "command": "multiGitExplorer.openInTerminal",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "5_reveal@2"
        },
        {
          "command": "multiGitExplorer.revealInExplorer",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "5_reveal@3"
        },
        {
          "command": "multiGitExplorer.findInFolder",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(folder|repo)/",
          "group": "6_search@1"
        },
        {
          "command": "multiGitExplorer.selectForCompare",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "7_compare@1"
        },
        {
          "command": "multiGitExplorer.compareWithSelected",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/ && multiGitExplorer.compareSelected",
          "group": "7_compare@2"
        },
        {
          "command": "multiGitExplorer.compareSelected",
          "when": "view == multiGitExplorer.explorer && multiGitExplorer.twoFilesSelected",
          "group": "7_compare@3"
        },
        {
          "command": "multiGitExplorer.openTimeline",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^file(?!.*\\bdeleted\\b)/",
          "group": "7_compare@4"
        },
        {
          "command": "multiGitExplorer.cut",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && viewItem =~ /^(?!.*\\broot\\b)/",
          "group": "8a_clipboard@1"
        },
        {
          "command": "multiGitExplorer.copy",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "8a_clipboard@2"
        },
        {
          "command": "multiGitExplorer.paste",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/",
          "group": "8a_clipboard@3"
        },
        {
          "command": "multiGitExplorer.copyPath",
          "when": "view == multiGitExplorer.explorer",
          "group": "8b_path@1"
        },
        {
          "command": "multiGitExplorer.copyRelativePath",
          "when": "view == multiGitExplorer.explorer",
          "group": "8b_path@2"
        },
        {
          "command": "multiGitExplorer.copyRemoteUrl",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\bhosted\\b/",
          "group": "8c_remote@1"
        },
        {
          "command": "multiGitExplorer.openOnRemote",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /\\bhosted\\b/",
          "group": "8c_remote@2"
        },
        {
          "command": "multiGitExplorer.rename",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && viewItem =~ /^(?!.*\\broot\\b)/",
          "group": "9_modify@1"
        },
        {
          "command": "multiGitExplorer.delete",
          "when": "view == multiGitExplorer.explorer && viewItem =~ /^(?!.*\\bdeleted\\b)/ && viewItem =~ /^(?!.*\\broot\\b)/",
          "group": "9_modify@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "multiGitExplorer.revealInFiles",
          "when": "resourceScheme == file",
          "group": "2_files@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "multiGitExplorer.repoMenu",
          "when": "explorerResourceIsFolder && config.multiGitExplorer.decorateExplorer && resourcePath in multiGitExplorer.repoPaths",
          "group": "7_multiGitExplorer@1"
        }
      ],
      "multiGitExplorer.repoMenu": [
        {
          "command": "multiGitExplorer.openInScm",
          "group": "1_scm@1"
        },
        {
          "command": "multiGitExplorer.openChanges",
          "group": "1_scm@2"
        },
        {
          "command": "multiGitExplorer.switchBranch",
          "group": "0_branch@1"
        },
        {
          "command": "multiGitExplorer.fetch",
          "group": "2_sync@1"
        },
        {
          "command": "multiGitExplorer.pull",
          "group": "2_sync@2"
        },
        {
          "command": "multiGitExplorer.push",
          "group": "2_sync@3"
        },
        {
          "command": "multiGitExplorer.openTerminal",
          "group": "3_open@1"
        },
        {
          "command": "multiGitExplorer.openInNewWindow",
          "group": "3_open@2"
        },
        {
          "command": "multiGitExplorer.copyBranch",
          "group": "3_open@3"
        }
      ],
      "commandPalette": [
        {
          "command": "multiGitExplorer.revealInFiles",
          "when": "resourceScheme == file"
        },
        {
          "command": "multiGitExplorer.openChanges",
          "when": "false"
        },
        {
          "command": "multiGitExplorer.fetch",
          "when": "false"
        },
        {
